# Admin ESA — Local / Firebase Studio dev example
# IMPORTANT:
# - Never expose SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_ vars
# - In Firebase Studio, your preview origin is dynamic. Set ADMIN_ESA_CANONICAL_ORIGIN to your current preview URL.

# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin used to build safe redirects in dev (must be the full origin, no path)
# Example: https://9000-firebase-admin-esa-xxxxxxxx.cluster-xxxxxxxxxxxxxxxx.cloudworkstations.dev
ADMIN_ESA_CANONICAL_ORIGIN=

# Optional: if you want to override redirect origin in some flows
NEXT_PUBLIC_SITE_URL=

# Stripe (server-only unless explicitly NEXT_PUBLIC)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
